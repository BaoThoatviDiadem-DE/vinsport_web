<!DOCTYPE html>
<html>
<head>
    <title>VINSPORT Control Center</title>
    <meta charset="utf-8">

    <HTA:APPLICATION
        APPLICATIONNAME="VINSPORT Control Center"
        SCROLL="yes"
        SINGLEINSTANCE="yes"
        WINDOWSTATE="normal"
        INNERBORDER="no"
        SYSMENU="yes"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="yes"
    >

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 18px;
            font-family: "Segoe UI", Tahoma, sans-serif;
            background: #eef2f7;
            color: #263445;
        }

        .container {
            width: 100%;
            max-width: 650px;
            margin: auto;
            background: #fff;
            border-radius: 15px;
            padding: 22px;
            box-shadow: 0 5px 22px rgba(20, 40, 70, .10);
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #e7edf4;
            padding-bottom: 15px;
            margin-bottom: 15px;
        }

        h1 {
            font-size: 22px;
            margin: 0;
            color: #174ea6;
        }

        .subtitle {
            font-size: 12px;
            color: #778396;
            margin-top: 5px;
        }

        .version {
            font-size: 11px;
            color: #64748b;
            background: #edf2f8;
            padding: 6px 9px;
            border-radius: 20px;
        }

        .section {
            margin-top: 19px;
        }

        .section-title {
            font-size: 12px;
            font-weight: 700;
            color: #66758a;
            letter-spacing: .5px;
            margin-bottom: 10px;
        }

        .grid {
            display: flex;
            gap: 10px;
        }

        .grid > button {
            flex: 1;
            min-width: 0;
        }

        .btn {
            border: none;
            border-radius: 8px;
            padding: 12px 10px;
            width: 100%;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            color: white;
            margin-bottom: 8px;
        }

        .btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

        .green { background: #16834a; }
        .green:hover { background: #116d3d; }

        .blue { background: #2563c7; }
        .blue:hover { background: #1d4fa4; }

        .orange { background: #e87918; }
        .orange:hover { background: #c65d0b; }

        .red { background: #d43c43; }
        .red:hover { background: #b92d34; }

        .purple { background: #7046bd; }
        .purple:hover { background: #59369b; }

        .gray { background: #64748b; }
        .gray:hover { background: #475569; }

        .panel {
            background: #f7f9fc;
            border: 1px solid #e5eaf1;
            border-radius: 10px;
            padding: 13px;
        }

        .status-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 7px 0;
            border-bottom: 1px solid #e8edf3;
            font-size: 13px;
        }

        .status-row:last-child {
            border-bottom: none;
        }

        .status-value {
            font-weight: 700;
            color: #64748b;
        }

        .running { color: #16834a; }
        .stopped { color: #d43c43; }
        .checking { color: #d97706; }

        .url-input {
            width: 100%;
            padding: 10px;
            border: 1px solid #d7e0eb;
            border-radius: 7px;
            background: white;
            font-size: 12px;
            color: #2457a6;
            margin-top: 7px;
        }

        .hint {
            font-size: 11px;
            color: #8491a2;
            margin-top: 7px;
            line-height: 1.5;
        }

        .message {
            display: none;
            background: #fff7e8;
            border: 1px solid #f5d69b;
            border-radius: 8px;
            padding: 10px;
            font-size: 12px;
            color: #975b08;
            margin-top: 10px;
        }

        .footer {
            text-align: center;
            color: #9aa5b3;
            font-size: 10px;
            margin-top: 20px;
        }

        hr {
            border: none;
            border-top: 1px solid #e7edf4;
            margin: 17px 0;
        }
    </style>

    <script language="VBScript">
        Dim objShell
        Set objShell = CreateObject("WScript.Shell")

        Function GetAppDir()
            Dim fso, p
            Set fso = CreateObject("Scripting.FileSystemObject")

            p = document.location.pathname
            p = Replace(p, "/", "\")

            If Left(p, 1) = "\" And Mid(p, 3, 1) = ":" Then
                p = Mid(p, 2)
            End If

            p = Unescape(p)
            GetAppDir = fso.GetParentFolderName(p)
        End Function

        Sub Window_OnLoad
            Dim appDir
            appDir = GetAppDir()

            ' Giữ hành vi tự khởi động Airflow như phiên bản cũ.
            objShell.Run "cmd /c cd /d """ & appDir & """ && docker-compose up -d", 0, False
        End Sub

        Sub Window_OnBeforeUnload
            Dim appDir, cmd

            appDir = GetAppDir()

            ' Chỉ dừng các tiến trình do Process Manager quản lý.
            cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -File """ & _
                  appDir & "\VinSport_Process_Manager.ps1"" -Mode Stop"

            objShell.Run cmd, 0, False

            ' Giữ hành vi tắt Airflow khi đóng HTA.
            objShell.Run "cmd /c cd /d """ & appDir & """ && docker-compose down", 0, False
        End Sub
    </script>

    <script language="JavaScript">
        var shell = new ActiveXObject("WScript.Shell");
        var activeStartupMode = "";
        var startupDeadline = 0;

        var backendReady = false;
        var frontendReady = false;
        var tunnelReady = false;

        var backendChecking = false;
        var frontendChecking = false;
        var airflowChecking = false;

        var currentPublicUrl = "";

        function appDirectory() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = decodeURIComponent(location.pathname.replace(/\//g, "\\"));

            if (path.charAt(0) == "\\" && path.charAt(2) == ":") {
                path = path.substring(1);
            }

            return fso.GetParentFolderName(path);
        }

        function runManager(mode) {
            var scriptPath = appDirectory() + "\\VinSport_Process_Manager.ps1";

            if (!(new ActiveXObject("Scripting.FileSystemObject")).FileExists(scriptPath)) {
                alert("Không tìm thấy VinSport_Process_Manager.ps1");
                return false;
            }

            var command =
                'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' +
                scriptPath + '" -Mode ' + mode;

            shell.Run(command, 0, false);
            return true;
        }

        function setStatus(id, text, cssClass) {
            var element = document.getElementById(id);
            element.innerHTML = text;
            element.className = "status-value " + cssClass;
        }

        function readPublicUrl() {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                var appData = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%");
                var path = appData + "\\VinSportControlPanel\\process-state.json";

                if (!fso.FileExists(path)) return "";

                var file = fso.OpenTextFile(path, 1, false, -2);
                var content = file.ReadAll();
                file.Close();

                var match = content.match(/"PublicUrl"\s*:\s*"([^"]*)"/i);

                if (match && match[1]) {
                    return match[1];
                }
            }
            catch (e) {}

            return "";
        }

        function checkHttp(url, callback) {
            try {
                var xhr = new ActiveXObject("MSXML2.XMLHTTP");

                xhr.open("GET", url, true);

                xhr.onreadystatechange = function() {
                    if (xhr.readyState == 4) {
                        callback(xhr.status >= 200 && xhr.status < 400);
                    }
                };

                xhr.send();
            }
            catch (e) {
                callback(false);
            }
        }

        function checkTunnelProcess() {
            try {
                var locator = new ActiveXObject("WbemScripting.SWbemLocator");
                var service = locator.ConnectServer(".", "root\\cimv2");

                var processes = service.ExecQuery(
                    "SELECT ProcessId, CommandLine FROM Win32_Process WHERE Name='cloudflared.exe'"
                );

                var item = new Enumerator(processes);

                for (; !item.atEnd(); item.moveNext()) {
                    var process = item.item();
                    var command = String(process.CommandLine || "");

                    if (command.indexOf("tunnel --url http://127.0.0.1:5173") >= 0) {
                        return true;
                    }
                }
            }
            catch (e) {}

            return false;
        }

        function refreshWebsiteStatus() {
            currentPublicUrl = readPublicUrl();

            document.getElementById("public-url").value =
                currentPublicUrl || "Chưa có Public URL";

            if (!backendChecking) {
                backendChecking = true;

                checkHttp("http://127.0.0.1:5000/", function(ok) {
                    backendReady = ok;
                    setStatus(
                        "backend-status",
                        ok ? "● Running" : "● Stopped",
                        ok ? "running" : "stopped"
                    );
                    backendChecking = false;
                    evaluateStartup();
                });
            }

            if (!frontendChecking) {
                frontendChecking = true;

                checkHttp("http://127.0.0.1:5173/", function(ok) {
                    frontendReady = ok;
                    setStatus(
                        "frontend-status",
                        ok ? "● Running" : "● Stopped",
                        ok ? "running" : "stopped"
                    );
                    frontendChecking = false;
                    evaluateStartup();
                });
            }

            tunnelReady = checkTunnelProcess();

            setStatus(
                "tunnel-status",
                tunnelReady ? "● Running" : "● Stopped",
                tunnelReady ? "running" : "stopped"
            );

            evaluateStartup();
        }

        function evaluateStartup() {
            if (!activeStartupMode) return;

            var ready =
                backendReady &&
                frontendReady &&
                (activeStartupMode != "Public" || (tunnelReady && currentPublicUrl != ""));

            if (ready) {
                var mode = activeStartupMode;
                activeStartupMode = "";

                document.getElementById("startup-message").style.display = "none";
                setButtonsEnabled(true);

                if (mode == "Public") {
                    openWebsite(currentPublicUrl);
                    showMessage("Public Website đã sẵn sàng.");
                }
                else {
                    openWebsite("http://localhost:5173");
                    showMessage("Local Website đã sẵn sàng.");
                }

                return;
            }

            if (new Date().getTime() > startupDeadline) {
                activeStartupMode = "";
                setButtonsEnabled(true);

                showMessage(
                    "Quá thời gian chờ khởi động. Kiểm tra PowerShell và log của Process Manager."
                );
            }
        }

        function setButtonsEnabled(enabled) {
            document.getElementById("btn-local").disabled = !enabled;
            document.getElementById("btn-public").disabled = !enabled;
        }

        function showMessage(message) {
            var el = document.getElementById("startup-message");
            el.innerHTML = message;
            el.style.display = "block";
        }

        function startWebsite(mode) {
            if (activeStartupMode) return;

            backendReady = false;
            frontendReady = false;
            tunnelReady = false;

            activeStartupMode = mode;
            startupDeadline = new Date().getTime() + 300000;

            setButtonsEnabled(false);

            showMessage(
                mode == "Public"
                ? "Đang khởi động Backend, Cloudflare Tunnel và Frontend..."
                : "Đang khởi động Backend và Frontend..."
            );

            var managerMode = mode == "Public" ? "StartPublic" : "StartLocal";

            if (!runManager(managerMode)) {
                activeStartupMode = "";
                setButtonsEnabled(true);
                return;
            }

            refreshWebsiteStatus();
        }

        function stopWebsite() {
            if (!confirm("Bạn muốn dừng toàn bộ Website VINSPORT?")) return;

            activeStartupMode = "";
            runManager("Stop");

            showMessage("Đã gửi lệnh dừng Website.");
            setButtonsEnabled(true);
        }

        function stopTunnel() {
            if (!tunnelReady) {
                alert("Cloudflare Tunnel hiện không chạy.");
                return;
            }

            if (!confirm("Dừng Cloudflare Tunnel? Backend và Frontend vẫn tiếp tục chạy.")) {
                return;
            }

            runManager("StopTunnel");
            showMessage("Đã gửi lệnh dừng Tunnel. Backend và Frontend được giữ nguyên.");
        }

        function openWebsite(url) {
            if (!url || url.indexOf("http") != 0) {
                alert("URL không hợp lệ.");
                return;
            }

            shell.Run('cmd /c start "" "' + url + '"', 0, false);
        }

        function openSelectedWebsite() {
            if (currentPublicUrl && tunnelReady) {
                openWebsite(currentPublicUrl);
            }
            else if (frontendReady) {
                openWebsite("http://localhost:5173");
            }
            else {
                alert("Website chưa sẵn sàng.");
            }
        }

        function copyPublicUrl() {
            if (!currentPublicUrl) {
                alert("Chưa có Public URL.");
                return;
            }

            try {
                window.clipboardData.setData("Text", currentPublicUrl);
                showMessage("Đã sao chép Public URL.");
            }
            catch (e) {
                alert("Không thể sao chép URL: " + e.message);
            }
        }

        function initDatabase() {
            var answer = confirm(
                "CẢNH BÁO: Thao tác này có thể Reset toàn bộ dữ liệu SQL Server về trạng thái mẫu ban đầu.\n\n" +
                "Chỉ tiếp tục nếu bạn hiểu rõ tác động của script db:init.\n\n" +
                "Bạn có chắc chắn muốn tiếp tục?"
            );

            if (!answer) return;

            var appDir = appDirectory();

            var command =
                'cmd /c cd /d "' + appDir +
                '\\backend" && npm.cmd run db:init && echo. && ' +
                'echo ================================================ && ' +
                'echo HOAN TAT - Nhan phim bat ky de dong cua so nay && pause >nul';

            shell.Run(command, 1, false);
        }

        function startAirflow() {
            var appDir = appDirectory();

            shell.Run(
                'cmd /c ""' + appDir + '\\start_airflow.bat""',
                0,
                false
            );

            showMessage("Đã gửi lệnh khởi động Airflow.");
        }

        function stopAirflow() {
            if (!confirm("Bạn muốn dừng toàn bộ Docker Compose Airflow?")) return;

            var appDir = appDirectory();

            shell.Run(
                'cmd /c cd /d "' + appDir + '" && docker-compose down',
                0,
                false
            );

            showMessage("Đã gửi lệnh dừng Airflow.");
        }

        function openAirflow() {
            openWebsite("http://localhost:8080");
        }

        function checkAirflowStatus() {
            if (airflowChecking) return;

            airflowChecking = true;

            checkHttp("http://localhost:8080/health", function(ok) {
                setStatus(
                    "airflow-status",
                    ok ? "● Running" : "● Stopped",
                    ok ? "running" : "stopped"
                );

                airflowChecking = false;
            });
        }

        function refreshAll() {
            refreshWebsiteStatus();
            checkAirflowStatus();
        }

        window.setTimeout(refreshAll, 1000);
        window.setInterval(refreshAll, 3000);
    </script>
</head>

<body>
    <div class="container">

        <div class="header">
            <div>
                <h1>VINSPORT</h1>
                <div class="subtitle">System Control Center</div>
            </div>
            <div class="version">CONTROL PANEL</div>
        </div>

        <div class="section">
            <div class="section-title">WEBSITE DEPLOYMENT</div>

            <div class="grid">
                <button id="btn-local" class="btn green"
                    onclick="startWebsite('Local')">
                    START LOCAL
                </button>

                <button id="btn-public" class="btn orange"
                    onclick="startWebsite('Public')">
                    START PUBLIC
                </button>
            </div>

            <div id="startup-message" class="message"></div>
        </div>

        <div class="section">
            <div class="section-title">SERVICE MONITORING</div>

            <div class="panel">
                <div class="status-row">
                    <span>Backend - Express :5000</span>
                    <span id="backend-status" class="status-value checking">Checking...</span>
                </div>

                <div class="status-row">
                    <span>Frontend - Vite :5173</span>
                    <span id="frontend-status" class="status-value checking">Checking...</span>
                </div>

                <div class="status-row">
                    <span>Cloudflare Tunnel</span>
                    <span id="tunnel-status" class="status-value checking">Checking...</span>
                </div>

                <div class="status-row">
                    <span>Apache Airflow :8080</span>
                    <span id="airflow-status" class="status-value checking">Checking...</span>
                </div>
            </div>
        </div>

        <div class="section">
            <div class="section-title">PUBLIC WEBSITE URL</div>

            <input
                id="public-url"
                class="url-input"
                type="text"
                readonly
                value="Chưa có Public URL"
            >

            <div class="grid" style="margin-top: 9px;">
                <button class="btn blue" onclick="copyPublicUrl()">
                    COPY URL
                </button>

                <button class="btn blue" onclick="openSelectedWebsite()">
                    OPEN WEBSITE
                </button>
            </div>

            <div class="grid">
                <button class="btn gray" onclick="stopTunnel()">
                    STOP TUNNEL
                </button>

                <button class="btn red" onclick="stopWebsite()">
                    STOP WEBSITE
                </button>
            </div>

            <div class="hint">
                Stop Tunnel chỉ dừng kết nối Internet công khai.
                Backend và Frontend vẫn tiếp tục hoạt động.
            </div>
        </div>

        <hr>

        <div class="section">
            <div class="section-title">SQL SERVER DATABASE</div>

            <button class="btn purple" onclick="initDatabase()">
                INITIALIZE DATABASE
            </button>

            <div class="hint">
                Chỉ chạy khi cần khởi tạo hoặc nạp lại dữ liệu mẫu.
                Hãy kiểm tra nội dung script db:init trước khi xác nhận.
            </div>
        </div>

        <div class="section">
            <div class="section-title">DATA ENGINEERING - AIRFLOW</div>

            <div class="grid">
                <button class="btn green" onclick="startAirflow()">
                    START AIRFLOW
                </button>

                <button class="btn blue" onclick="openAirflow()">
                    OPEN AIRFLOW
                </button>

                <button class="btn red" onclick="stopAirflow()">
                    STOP AIRFLOW
                </button>
            </div>
        </div>

        <div class="footer">
            VINSPORT CONTROL CENTER | LOCAL + CLOUD INFRASTRUCTURE
        </div>

    </div>
</body>
</html>